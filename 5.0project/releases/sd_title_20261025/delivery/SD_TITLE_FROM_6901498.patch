diff --git a/5.0project/tests/reference/sd_title/photo_award_notice.v b/5.0project/tests/reference/sd_title/photo_award_notice.v
new file mode 100644
index 0000000..b3a074a
--- /dev/null
+++ b/5.0project/tests/reference/sd_title/photo_award_notice.v
@@ -0,0 +1,115 @@
+module photo_award_notice_before(input clk,rst,input [2:0] notice,input [11:0] x,input [10:0] y,
+ input [23:0] rgb_in,output [23:0] rgb_out);
+reg notice_visible;
+wire box=notice_visible && x>=16 && x<280 && y>=16 && y<48;
+wire letters=x>=24 && x<264 && y>=22 && y<36;
+wire [11:0] dx=x-24;wire [10:0] dy=y-22;
+reg [2:0] notice_code;reg [7:0] ch;reg [34:0] glyph;reg ink;
+// The message has only four fixed alternatives. Select the character
+// directly; a 120-bit variable barrel shift is unnecessary on every pixel.
+function [7:0] notice_character;input[2:0] code;input[3:0] position;begin
+ notice_character=0;
+ case(code)
+ 1:case(position)
+  0:notice_character=8'h41;
+  1:notice_character=8'h57;
+  2:notice_character=8'h41;
+  3:notice_character=8'h52;
+  4:notice_character=8'h44;
+  5:notice_character=8'h20;
+  6:notice_character=8'h4c;
+  7:notice_character=8'h4f;
+  8:notice_character=8'h41;
+  9:notice_character=8'h44;
+  10:notice_character=8'h49;
+  11:notice_character=8'h4e;
+  12:notice_character=8'h47;
+  13:notice_character=8'h20;
+  14:notice_character=8'h20;
+  default:notice_character=0;
+ endcase
+ 2:case(position)
+  0:notice_character=8'h41;
+  1:notice_character=8'h57;
+  2:notice_character=8'h41;
+  3:notice_character=8'h52;
+  4:notice_character=8'h44;
+  5:notice_character=8'h20;
+  6:notice_character=8'h4e;
+  7:notice_character=8'h4f;
+  8:notice_character=8'h54;
+  9:notice_character=8'h20;
+  10:notice_character=8'h46;
+  11:notice_character=8'h4f;
+  12:notice_character=8'h55;
+  13:notice_character=8'h4e;
+  14:notice_character=8'h44;
+  default:notice_character=0;
+ endcase
+ 3:case(position)
+  0:notice_character=8'h41;
+  1:notice_character=8'h57;
+  2:notice_character=8'h41;
+  3:notice_character=8'h52;
+  4:notice_character=8'h44;
+  5:notice_character=8'h20;
+  6:notice_character=8'h45;
+  7:notice_character=8'h52;
+  8:notice_character=8'h52;
+  9:notice_character=8'h4f;
+  10:notice_character=8'h52;
+  11:notice_character=8'h20;
+  12:notice_character=8'h20;
+  13:notice_character=8'h20;
+  14:notice_character=8'h20;
+  default:notice_character=0;
+ endcase
+ 4:case(position)
+  0:notice_character=8'h50;
+  1:notice_character=8'h48;
+  2:notice_character=8'h4f;
+  3:notice_character=8'h54;
+  4:notice_character=8'h4f;
+  5:notice_character=8'h20;
+  6:notice_character=8'h45;
+  7:notice_character=8'h52;
+  8:notice_character=8'h52;
+  9:notice_character=8'h4f;
+  10:notice_character=8'h52;
+  11:notice_character=8'h20;
+  12:notice_character=8'h20;
+  13:notice_character=8'h20;
+  14:notice_character=8'h20;
+  default:notice_character=0;
+ endcase
+ default:notice_character=0;
+ endcase
+end endfunction
+always @(posedge clk or posedge rst)begin
+ if(rst)begin notice_code<=0;notice_visible<=0;end
+ else begin notice_code<=notice;notice_visible<=notice!=0;end
+end
+always @*begin
+ ch=notice_character(notice_code,dx[7:4]);
+ case(ch)
+  "P":glyph=35'b11110_10001_10001_11110_10000_10000_10000;
+  "H":glyph=35'b10001_10001_10001_11111_10001_10001_10001;
+  "A":glyph=35'b01110_10001_10001_11111_10001_10001_10001;
+  "W":glyph=35'b10001_10001_10001_10101_10101_11011_10001;
+  "R":glyph=35'b11110_10001_10001_11110_10100_10010_10001;
+  "D":glyph=35'b11110_10001_10001_10001_10001_10001_11110;
+  "L":glyph=35'b10000_10000_10000_10000_10000_10000_11111;
+  "O":glyph=35'b01110_10001_10001_10001_10001_10001_01110;
+  "I":glyph=35'b11111_00100_00100_00100_00100_00100_11111;
+  "N":glyph=35'b10001_11001_11001_10101_10011_10011_10001;
+  "G":glyph=35'b01110_10001_10000_10111_10001_10001_01110;
+  "T":glyph=35'b11111_00100_00100_00100_00100_00100_00100;
+  "F":glyph=35'b11111_10000_10000_11110_10000_10000_10000;
+  "U":glyph=35'b10001_10001_10001_10001_10001_10001_01110;
+  "E":glyph=35'b11111_10000_10000_11110_10000_10000_11111;
+  default:glyph=0;
+ endcase
+ ink=letters && dx[3:1]<5 && glyph[34-(dy[3:1]*5+dx[3:1])];
+end
+assign rgb_out=box ? (ink ? 24'hffffff:24'h202020):rgb_in;
+endmodule
diff --git a/5.0project/tests/reference/sd_title/saixian_osd_overlay.v b/5.0project/tests/reference/sd_title/saixian_osd_overlay.v
new file mode 100644
index 0000000..6d60526
--- /dev/null
+++ b/5.0project/tests/reference/sd_title/saixian_osd_overlay.v
@@ -0,0 +1,659 @@
+module saixian_osd_overlay_before #(parameter SHOW_SOURCE_RESOLUTION=1)(
+    input  wire        clk,
+    input  wire        rst,
+    input  wire        frame_tick,
+    input  wire        de_i,
+    input  wire [9:0]  x_i,
+    input  wire [8:0]  y_i,
+    input  wire [23:0] rgb_in_i,
+    input  wire        display_valid,
+    input  wire [2:0]  loading_phase,
+    input  wire [3:0]  state,
+    input  wire [1:0]  project_id,
+    input  wire [6:0]  minutes,
+    input  wire [5:0]  seconds,
+    input  wire [3:0]  countdown_value,
+    input  wire [10:0] ticker_x,
+    input  wire [4:0]  ticker_text_length,
+    input  wire [4:0]  title_text_length,
+    input  wire        font_ready,
+    output wire [10:0] font_addr,
+    input  wire [15:0] font_bits,
+    input  wire [15:0] source_width_bcd,
+    input  wire [15:0] source_height_bcd,
+    input  wire [2:0]  error_code,
+    input wire [6:0] visual_height,visual_peak,
+    input wire [31:0] visual_wave,
+    input wire visual_fft_valid,visual_wave_valid,
+    input  wire        waveform_mode,
+    input  wire        settings_mode,
+    input  wire [2:0]  setting_item,
+    input  wire [3:0]  volume_setting,
+    input  wire [3:0]  brightness_setting,
+    input  wire [3:0]  contrast_setting,
+    input  wire [1:0]  sharpness_setting,
+    input  wire [3:0]  saturation_setting,
+    input  wire        invert_setting,
+    input  wire        vintage_setting,
+    input  wire [1:0]  enhancement_setting,
+    output reg  [23:0] rgb_out
+);
+
+localparam ST_CAROUSEL = 4'd0;
+localparam ST_PREPARE  = 4'd1;
+localparam ST_COUNT3   = 4'd2;
+localparam ST_COUNT2   = 4'd3;
+localparam ST_COUNT1   = 4'd4;
+localparam ST_START    = 4'd5;
+localparam ST_RUNNING  = 4'd6;
+localparam ST_PAUSED   = 4'd7;
+localparam ST_FINISH   = 4'd8;
+
+wire [3:0] row0_value = setting_item[2] ? saturation_setting : volume_setting;
+wire [3:0] row1_value = setting_item[2] ? {3'd0,invert_setting} : brightness_setting;
+wire [3:0] row2_value = setting_item[2] ? {3'd0,vintage_setting} : contrast_setting;
+wire [3:0] row3_value = setting_item[2] ? {2'd0,enhancement_setting} : {2'd0,sharpness_setting};
+
+reg [6:0] glyph_id;
+reg [3:0] font_row;
+reg [3:0] font_col;
+reg       text_region;
+reg [23:0] text_color;
+reg [3:0] slot;
+reg [9:0] local_x;
+reg [8:0] local_y;
+reg [23:0] base_rgb;
+reg [9:0] progress_width;
+reg [3:0] setting_value;
+reg [9:0] setting_bar_width;
+reg       spinner_pixel;
+reg [2:0] spinner_segment;
+reg [6:0] glyph_id_q;
+reg [3:0] font_row_q;
+reg [3:0] font_col_q;
+reg       text_region_q;
+reg       text_enable_q;
+reg [23:0] text_color_q;
+reg [23:0] render_rgb_q;
+reg display_valid_q;
+reg [2:0] error_code_q;
+reg       waveform_mode_q;
+reg [3:0]  font_col_q2;
+reg        text_region_q2;
+reg        text_enable_q2;
+reg [23:0] text_color_q2;
+reg [23:0] render_rgb_q2;
+reg [23:0] rgb_comb;
+reg        de;
+reg [9:0]  x;
+reg [8:0]  y;
+reg [23:0] rgb_in;
+wire font_pixel_q = font_ready && font_bits[15-font_col_q2];
+wire [11:0] ticker_width = (ticker_text_length == 0) ? 12'd224 :
+                           {2'b0,ticker_text_length,5'b0};
+wire [11:0] ticker_local_x = {2'b0, x} + ticker_width - {1'b0, ticker_x};
+reg [9:0] title_scroll_x;
+wire [10:0] title_local_x = {1'b0,x} + 11'd108 - {1'b0,title_scroll_x};
+// 75% of the underlying photograph; only trace/peak pixels are opaque.
+function [7:0] background_channel;
+ input [7:0] value;begin background_channel=(value>>1)+(value>>2);end
+endfunction
+wire [23:0] plot_background={background_channel(rgb_in[23:16]),background_channel(rgb_in[15:8]),background_channel(rgb_in[7:0])};
+wire [23:0] plot_grid={plot_background[23:16]+8'd8,plot_background[15:8]+8'd14,plot_background[7:0]+8'd19};
+wire [23:0] plot_axis={plot_background[23:16]+8'd17,plot_background[15:8]+8'd24,plot_background[7:0]+8'd30};
+reg [23:0] visual_plot_rgb;
+reg [23:0] plot_background_q;
+reg [8:0] plot_flags_q;
+reg visual_plot_active_q;
+reg [6:0] visual_distance;
+reg signed [6:0] wave_amplitude;
+wire wave_left_pixel=wave_amplitude >= $signed({visual_wave[31],visual_wave[31:26]}) &&
+    wave_amplitude <= $signed({visual_wave[23],visual_wave[23:18]});
+wire wave_right_pixel=wave_amplitude >= $signed({visual_wave[15],visual_wave[15:10]}) &&
+    wave_amplitude <= $signed({visual_wave[7],visual_wave[7:2]});
+always @(posedge clk) begin
+    visual_distance<=9'd391-y_i;
+    wave_amplitude<=9'd356-y_i;
+end
+wire visual_plot_active=de && display_valid_q && error_code_q==0 && !settings_mode &&
+    x>=64 && x<576 && y>=320 && y<392;
+// Retain the existing video latency. Register RAM comparisons first,
+// then choose colours in the existing general-render merge stage.
+wire plot_grid_pixel=y==320 || y==344 || y==368 || y==391 || x[6:0]==64;
+wire plot_bar_pixel=visual_fft_valid && x[3:0]<12 && visual_height!=0 && visual_distance<=visual_height;
+wire plot_peak_pixel=visual_fft_valid && x[3:0]<12 && visual_peak!=0 && visual_distance==visual_peak;
+wire [23:0] plot_grid_q={plot_background_q[23:16]+8'd8,plot_background_q[15:8]+8'd14,plot_background_q[7:0]+8'd19};
+wire [23:0] plot_axis_q={plot_background_q[23:16]+8'd17,plot_background_q[15:8]+8'd24,plot_background_q[7:0]+8'd30};
+always @* begin
+    visual_plot_rgb=plot_background_q;
+    if(plot_flags_q[8]) visual_plot_rgb=plot_grid_q;
+    if(!plot_flags_q[0]) begin
+        if(plot_flags_q[7]) begin
+            if(plot_flags_q[5]) visual_plot_rgb=24'hFFCF66;
+            else if(plot_flags_q[4]) visual_plot_rgb=24'h42E5AF;
+            else visual_plot_rgb=24'h37CFFF;
+        end
+        if(plot_flags_q[6]) visual_plot_rgb=24'hFFF0C2;
+    end else begin
+        if(plot_flags_q[3]) visual_plot_rgb=plot_axis_q;
+        if(plot_flags_q[2]) visual_plot_rgb=24'h37DFFF;
+        if(plot_flags_q[1]) visual_plot_rgb=24'hFFB85C;
+        if(plot_flags_q[2] && plot_flags_q[1]) visual_plot_rgb=24'hE8F4FF;
+    end
+end
+
+assign font_addr = {glyph_id_q,font_row_q};
+always @(posedge clk or posedge rst) begin
+    if (rst) title_scroll_x <= 0;
+    else if (frame_tick && title_text_length != 0) begin
+        if (title_scroll_x >= (10'd128 + {title_text_length,5'b0})) title_scroll_x <= 0;
+        else title_scroll_x <= title_scroll_x + 1'b1;
+    end else if (title_text_length == 0) title_scroll_x <= 0;
+end
+
+function [6:0] digit_glyph;
+    input [3:0] digit;
+    begin
+        digit_glyph = {3'd0,digit} + 7'd1;
+    end
+endfunction
+
+function [6:0] project_glyph;
+    input [1:0] project;
+    input [3:0] index;
+    begin
+        project_glyph = 7'd0;
+        case (project)
+            2'd0: case (index)
+                0: project_glyph=7'd2; 1: project_glyph=7'd1;
+                2: project_glyph=7'd1; 3: project_glyph=7'd37;
+                default: project_glyph=7'd0;
+            endcase
+            2'd1: case (index)
+                0: project_glyph=7'd38; 1: project_glyph=7'd39;
+                default: project_glyph=7'd0;
+            endcase
+            2'd2: case (index)
+                0: project_glyph=7'd40; 1: project_glyph=7'd41;
+                2: project_glyph=7'd42; 3: project_glyph=7'd40;
+                default: project_glyph=7'd0;
+            endcase
+            default: case (index)
+                0: project_glyph=7'd43; 1: project_glyph=7'd44;
+                2: project_glyph=7'd45; 3: project_glyph=7'd46;
+                default: project_glyph=7'd0;
+            endcase
+        endcase
+    end
+endfunction
+
+function [6:0] state_glyph;
+    input [3:0] current_state;
+    input [3:0] index;
+    begin
+        state_glyph = 7'd0;
+        case (current_state)
+            ST_CAROUSEL: case(index)
+                0:state_glyph=7'd15; 1:state_glyph=7'd16; 2:state_glyph=7'd17;
+                3:state_glyph=7'd18; 4:state_glyph=7'd19; 5:state_glyph=7'd20;
+                default:state_glyph=7'd0;
+            endcase
+            ST_PREPARE: case(index)
+                0:state_glyph=7'd47; 1:state_glyph=7'd48;
+                2:state_glyph=7'd21; 3:state_glyph=7'd22;
+                default:state_glyph=7'd0;
+            endcase
+            ST_COUNT3,ST_COUNT2,ST_COUNT1: case(index)
+                0:state_glyph=7'd23; 1:state_glyph=7'd24; 2:state_glyph=7'd25;
+                default:state_glyph=7'd0;
+            endcase
+            ST_START: case(index)
+                0:state_glyph=7'd70; 1:state_glyph=7'd15;
+                2:state_glyph=7'd26; 3:state_glyph=7'd27;
+                default:state_glyph=7'd0;
+            endcase
+            ST_RUNNING: case(index)
+                0:state_glyph=7'd70; 1:state_glyph=7'd15; 2:state_glyph=7'd28;
+                3:state_glyph=7'd29; 4:state_glyph=7'd30;
+                default:state_glyph=7'd0;
+            endcase
+            ST_PAUSED: case(index)
+                0:state_glyph=7'd70; 1:state_glyph=7'd15;
+                2:state_glyph=7'd31; 3:state_glyph=7'd32;
+                default:state_glyph=7'd0;
+            endcase
+            ST_FINISH: case(index)
+                0:state_glyph=7'd70; 1:state_glyph=7'd15;
+                2:state_glyph=7'd35; 3:state_glyph=7'd36;
+                default:state_glyph=7'd0;
+            endcase
+            default: state_glyph=7'd0;
+        endcase
+    end
+endfunction
+
+function [6:0] ticker_glyph;
+    input [1:0] project;
+    input [3:0] index;
+    begin
+        ticker_glyph = 7'd0;
+        case (index)
+            0: ticker_glyph = 7'd80; // 转
+            1: ticker_glyph = 7'd20; // 播
+            2: ticker_glyph = 7'd11; // :
+            default: begin
+                case (project)
+                    2'd0: case (index)
+                        3:ticker_glyph=7'd2; 4:ticker_glyph=7'd1;
+                        5:ticker_glyph=7'd1; 6:ticker_glyph=7'd37;
+                        default:ticker_glyph=7'd0;
+                    endcase
+                    2'd1: case (index)
+                        3:ticker_glyph=7'd38; 4:ticker_glyph=7'd39;
+                        default:ticker_glyph=7'd0;
+                    endcase
+                    2'd2: case (index)
+                        3:ticker_glyph=7'd40; 4:ticker_glyph=7'd41;
+                        5:ticker_glyph=7'd42; 6:ticker_glyph=7'd40;
+                        default:ticker_glyph=7'd0;
+                    endcase
+                    default: case (index)
+                        3:ticker_glyph=7'd43; 4:ticker_glyph=7'd44;
+                        5:ticker_glyph=7'd45; 6:ticker_glyph=7'd46;
+                        default:ticker_glyph=7'd0;
+                    endcase
+                endcase
+            end
+        endcase
+    end
+endfunction
+
+function [6:0] error_glyph;
+    input [2:0] code;
+    input [3:0] index;
+    begin
+        error_glyph = 7'd0;
+        case (code)
+            3'd1: case(index)
+                0:error_glyph=7'd50; 1:error_glyph=7'd51; 2:error_glyph=7'd49;
+                default:error_glyph=7'd0;
+            endcase
+            3'd2: case(index)
+                0:error_glyph=7'd53; 1:error_glyph=7'd54;
+                2:error_glyph=7'd55; 3:error_glyph=7'd56;
+                default:error_glyph=7'd0;
+            endcase
+            3'd3: case(index)
+                0:error_glyph=7'd57; 1:error_glyph=7'd58; 2:error_glyph=7'd59;
+                default:error_glyph=7'd0;
+            endcase
+            3'd4: case(index)
+                0:error_glyph=7'd60; 1:error_glyph=7'd61;
+                2:error_glyph=7'd55; 3:error_glyph=7'd56;
+                default:error_glyph=7'd0;
+            endcase
+            default: case(index)
+                0:error_glyph=7'd62; 1:error_glyph=7'd63;
+                2:error_glyph=7'd64; 3:error_glyph=7'd63;
+                default:error_glyph=7'd0;
+            endcase
+        endcase
+    end
+endfunction
+
+always @* begin
+    glyph_id   = 7'd0;
+    font_row   = 4'd0;
+    font_col   = 4'd0;
+    text_region = 1'b0;
+    text_color = 24'hFFFFFF;
+    slot       = 4'd0;
+    local_x    = 10'd0;
+    local_y    = 9'd0;
+
+    if (error_code_q != 0) begin
+        if ((x >= 10'd224) && (x < 10'd416) && (y >= 9'd96) && (y < 9'd160)) begin
+            local_x = x - 10'd224;
+            slot = local_x[9:6];
+            font_col = local_x[5:2];
+            font_row = (y - 9'd96) >> 2;
+            case(slot)
+                0:glyph_id=7'd12;
+                1:glyph_id=7'd1;
+                2:glyph_id=digit_glyph({1'b0,error_code_q});
+                default:glyph_id=7'd0;
+            endcase
+            text_region=1'b1;
+            text_color=24'hFFD166;
+        end else if ((x >= 10'd192) && (x < 10'd448) && (y >= 9'd208) && (y < 9'd272)) begin
+            local_x = x - 10'd192;
+            slot = local_x[9:6];
+            font_col = local_x[5:2];
+            font_row = (y - 9'd208) >> 2;
+            glyph_id = error_glyph(error_code_q,slot);
+            text_region=1'b1;
+        end
+    end else if (display_valid_q && settings_mode) begin
+        // Settings title: 设置
+        if ((x >= 10'd288) && (x < 10'd352) && (y >= 9'd84) && (y < 9'd116)) begin
+            local_x = x - 10'd288;
+            slot = local_x[8:5];
+            font_col = local_x[4:1];
+            font_row = (y - 9'd84) >> 1;
+            glyph_id = (slot == 0) ? 7'd72 : ((slot == 1) ? 7'd73 : 7'd0);
+            text_region = 1'b1;
+            text_color = 24'h7DE3FF;
+        end else if ((x >= 10'd160) && (x < 10'd224) &&
+                     (((y >= 9'd144) && (y < 9'd176)) ||
+                      ((y >= 9'd200) && (y < 9'd232)) ||
+                      ((y >= 9'd256) && (y < 9'd288)) ||
+                      ((y >= 9'd312) && (y < 9'd344)))) begin
+            local_x = x - 10'd160;
+            slot = local_x[8:5];
+            font_col = local_x[4:1];
+            if (y < 9'd176) begin
+                font_row = (y - 9'd144) >> 1;
+                glyph_id = setting_item[2] ? ((slot == 0) ? 7'd81 : 7'd82) :
+                    ((slot == 0) ? 7'd74 : 7'd75); // 饱和 / 音量
+            end else if (y < 9'd232) begin
+                font_row = (y - 9'd200) >> 1;
+                glyph_id = setting_item[2] ? ((slot == 0) ? 7'd83 : 7'd84) :
+                    ((slot == 0) ? 7'd76 : 7'd77); // 反色 / 亮度
+            end else if (y < 9'd288) begin
+                font_row = (y - 9'd256) >> 1;
+                glyph_id = setting_item[2] ? ((slot == 0) ? 7'd85 : 7'd86) :
+                    ((slot == 0) ? 7'd78 : 7'd70); // 复古 / 对比
+            end else begin
+                font_row = (y - 9'd312) >> 1;
+                glyph_id = setting_item[2] ? ((slot==0) ? 7'd12 : 7'd0) :
+                    ((slot == 0) ? 7'd79 : ((slot == 1) ? 7'd77 : 7'd0)); // 锐度
+            end
+            text_region = 1'b1;
+            text_color = 24'hFFFFFF;
+        end else if ((x >= 10'd464) && (x < 10'd496) &&
+                     (((y >= 9'd144) && (y < 9'd176)) ||
+                      ((y >= 9'd200) && (y < 9'd232)) ||
+                      ((y >= 9'd256) && (y < 9'd288)) ||
+                      ((y >= 9'd312) && (y < 9'd344)))) begin
+            font_col = (x - 10'd464) >> 1;
+            if (y < 9'd176) begin font_row = (y - 9'd144) >> 1; glyph_id = digit_glyph(row0_value); end
+            else if (y < 9'd232) begin font_row = (y - 9'd200) >> 1; glyph_id = digit_glyph(row1_value); end
+            else if (y < 9'd288) begin font_row = (y - 9'd256) >> 1; glyph_id = digit_glyph(row2_value); end
+            else begin font_row = (y - 9'd312) >> 1; glyph_id = digit_glyph(row3_value); end
+            text_region = 1'b1;
+            text_color = 24'hFFD166;
+        end
+    end else if (display_valid_q) begin
+        if ((state == ST_CAROUSEL) && (ticker_text_length != 0) &&
+                     (ticker_local_x < {2'b0,ticker_text_length,5'b0}) &&
+                     (y >= 9'd432) && (y < 9'd464)) begin
+            local_x = ticker_local_x[9:0];
+            font_col = local_x[4:1];
+            font_row = (y - 9'd432) >> 1;
+            glyph_id = 7'd88 + ticker_local_x[9:5];
+            text_region = 1'b1;
+            text_color = 24'hFFD166;
+        end else if ((state == ST_CAROUSEL) && (ticker_text_length == 0) &&
+                     (ticker_local_x < 12'd224) &&
+                     (y >= 9'd432) && (y < 9'd464)) begin
+            local_x = ticker_local_x[9:0];
+            slot = local_x[8:5];
+            font_col = local_x[4:1];
+            font_row = (y - 9'd432) >> 1;
+            glyph_id = ticker_glyph(project_id,slot);
+            text_region=1'b1;
+            text_color=(slot >= 3) ? 24'hFFD166 : 24'hFFFFFF;
+        end else if ((x >= 10'd20) && (x < 10'd148) && (y >= 9'd16) && (y < 9'd48) &&
+                     (title_text_length != 0)) begin
+            font_col = title_local_x[4:1];
+            font_row = (y - 9'd16) >> 1;
+            glyph_id = (title_local_x < {1'b0,title_text_length,5'b0}) ?
+                       (7'd108 + title_local_x[9:5]) : 7'd0;
+            text_region = 1'b1;
+        end else if ((x >= 10'd20) && (x < 10'd148) && (y >= 9'd16) && (y < 9'd48)) begin
+            local_x = x - 10'd20;
+            slot = local_x[8:5];
+            font_col = local_x[4:1];
+            font_row = (y - 9'd16) >> 1;
+            glyph_id = project_glyph(project_id,slot);
+            text_region=1'b1;
+        end else if ((state != ST_CAROUSEL) && (x >= 10'd460) && (x < 10'd620) && (y >= 9'd16) && (y < 9'd48)) begin
+            local_x = x - 10'd460;
+            slot = local_x[8:5];
+            font_col = local_x[4:1];
+            font_row = (y - 9'd16) >> 1;
+            case(slot)
+                0:glyph_id=digit_glyph(minutes / 10);
+                1:glyph_id=digit_glyph(minutes % 10);
+                2:glyph_id=7'd11;
+                3:glyph_id=digit_glyph(seconds / 10);
+                4:glyph_id=digit_glyph(seconds % 10);
+                default:glyph_id=7'd0;
+            endcase
+            text_region=1'b1;
+        end else if (SHOW_SOURCE_RESOLUTION && (state == ST_CAROUSEL) && (x >= 10'd400) && (x < 10'd544) && (y >= 9'd24) && (y < 9'd40)) begin
+            // Source BMP dimensions: four digits, 'x', four digits.
+            local_x = x - 10'd400;
+            slot = local_x[7:4];
+            font_col = local_x[3:0];
+            // In this branch y is 24..39; this is exactly y-24 without an adder.
+            font_row = {~y[3], y[2:0]};
+            case(slot)
+                0:glyph_id=(source_width_bcd[15:12] == 0) ? 7'd0 : digit_glyph(source_width_bcd[15:12]);
+                1:glyph_id=((source_width_bcd[15:12] == 0) && (source_width_bcd[11:8] == 0)) ? 7'd0 : digit_glyph(source_width_bcd[11:8]);
+                2:glyph_id=((source_width_bcd[15:8] == 0) && (source_width_bcd[7:4] == 0)) ? 7'd0 : digit_glyph(source_width_bcd[7:4]);
+                3:glyph_id=digit_glyph(source_width_bcd[3:0]);
+                4:glyph_id=7'd71;
+                5:glyph_id=(source_height_bcd[15:12] == 0) ? 7'd0 : digit_glyph(source_height_bcd[15:12]);
+                6:glyph_id=((source_height_bcd[15:12] == 0) && (source_height_bcd[11:8] == 0)) ? 7'd0 : digit_glyph(source_height_bcd[11:8]);
+                7:glyph_id=((source_height_bcd[15:8] == 0) && (source_height_bcd[7:4] == 0)) ? 7'd0 : digit_glyph(source_height_bcd[7:4]);
+                8:glyph_id=digit_glyph(source_height_bcd[3:0]);
+                default:glyph_id=7'd0;
+            endcase
+            text_region=1'b1;
+            text_color=24'h9FE7FF;
+        end else if ((x >= 10'd180) && (x < 10'd372) && (y >= 9'd16) && (y < 9'd48)) begin
+            // Keep the normal state label inside the top OSD bar so carousel
+            // images remain unobstructed. Six 16x16 glyphs are scaled 2x.
+            local_x = x - 10'd180;
+            slot = local_x[8:5];
+            font_col = local_x[4:1];
+            font_row = (y - 9'd16) >> 1;
+            glyph_id = state_glyph(state,slot);
+            text_region=1'b1;
+            case(state)
+                ST_RUNNING: text_color=24'h5CFF8A;
+                ST_PAUSED : text_color=24'hFFD166;
+                ST_FINISH : text_color=24'hFF6B6B;
+                default   : text_color=24'hFFFFFF;
+            endcase
+        end else if ((state >= ST_COUNT3) && (state <= ST_COUNT1) &&
+                     (x >= 10'd256) && (x < 10'd384) && (y >= 9'd210) && (y < 9'd338)) begin
+            local_x = x - 10'd256;
+            font_col = local_x[6:3];
+            font_row = (y - 9'd210) >> 3;
+            glyph_id = digit_glyph(countdown_value);
+            text_region=1'b1;
+            text_color=24'hFFD166;
+        end
+    end
+end
+
+always @* begin
+    progress_width = seconds * 10'd8;
+    setting_value = 4'd0;
+    setting_bar_width = 10'd0;
+    spinner_pixel = 1'b0;
+    spinner_segment = 3'd0;
+
+    if (!de)
+        base_rgb = 24'd0;
+    else if (error_code_q != 0)
+        base_rgb = {8'h38 + {5'd0,y[4:2]},8'h08,8'h12};
+    else if (!display_valid_q)
+        base_rgb = {8'h08,8'h18 + {5'd0,y[4:2]},8'h30};
+    else
+        base_rgb = rgb_in;
+
+    rgb_comb = base_rgb;
+
+    // Eight-spoke boot spinner. One bright spoke advances at 10 Hz while the
+    // remaining spokes stay dim, making SD scan/first-frame progress visible.
+    if (de && (error_code_q == 0) && !display_valid_q) begin
+        if ((x >= 10'd314) && (x < 10'd326) && (y >= 9'd178) && (y < 9'd204)) begin
+            spinner_pixel = 1'b1; spinner_segment = 3'd0;
+        end else if ((x >= 10'd342) && (x < 10'd360) && (y >= 9'd194) && (y < 9'd212)) begin
+            spinner_pixel = 1'b1; spinner_segment = 3'd1;
+        end else if ((x >= 10'd350) && (x < 10'd376) && (y >= 9'd226) && (y < 9'd238)) begin
+            spinner_pixel = 1'b1; spinner_segment = 3'd2;
+        end else if ((x >= 10'd342) && (x < 10'd360) && (y >= 9'd252) && (y < 9'd270)) begin
+            spinner_pixel = 1'b1; spinner_segment = 3'd3;
+        end else if ((x >= 10'd314) && (x < 10'd326) && (y >= 9'd260) && (y < 9'd286)) begin
+            spinner_pixel = 1'b1; spinner_segment = 3'd4;
+        end else if ((x >= 10'd280) && (x < 10'd298) && (y >= 9'd252) && (y < 9'd270)) begin
+            spinner_pixel = 1'b1; spinner_segment = 3'd5;
+        end else if ((x >= 10'd264) && (x < 10'd290) && (y >= 9'd226) && (y < 9'd238)) begin
+            spinner_pixel = 1'b1; spinner_segment = 3'd6;
+        end else if ((x >= 10'd280) && (x < 10'd298) && (y >= 9'd194) && (y < 9'd212)) begin
+            spinner_pixel = 1'b1; spinner_segment = 3'd7;
+        end
+
+        if (spinner_pixel)
+            rgb_comb = (spinner_segment == loading_phase) ? 24'h38E8FF : 24'h23506A;
+    end
+
+    else if (de && display_valid_q && settings_mode && (error_code_q == 0)) begin
+        if ((x >= 10'd112) && (x < 10'd528) && (y >= 9'd64) && (y < 9'd384))
+            rgb_comb = 24'h101827;
+
+        if (((y >= 9'd136) && (y < 9'd184)) ||
+            ((y >= 9'd192) && (y < 9'd240)) ||
+            ((y >= 9'd248) && (y < 9'd296)) ||
+            ((y >= 9'd304) && (y < 9'd352))) begin
+            if (y < 9'd184) begin setting_value = row0_value; setting_bar_width = row0_value * 10'd24; end
+            else if (y < 9'd240) begin setting_value = row1_value; setting_bar_width = setting_item[2] ? (invert_setting ? 10'd192 : 10'd0) : brightness_setting * 10'd24; end
+            else if (y < 9'd296) begin setting_value = row2_value; setting_bar_width = setting_item[2] ? (vintage_setting ? 10'd192 : 10'd0) : contrast_setting * 10'd24; end
+            else begin setting_value = row3_value; setting_bar_width = row3_value * 10'd64; end
+
+            if ((setting_item[1:0] == 0 && y < 9'd184) ||
+                (setting_item[1:0] == 1 && y >= 9'd192 && y < 9'd240) ||
+                (setting_item[1:0] == 2 && y >= 9'd248 && y < 9'd296) ||
+                (setting_item[1:0] == 3 && y >= 9'd304)) begin
+                if ((x >= 10'd128) && (x < 10'd512)) rgb_comb = 24'h203B5A;
+            end
+
+            if ((!setting_item[2] || y < 9'd304) && (x >= 10'd248) && (x < 10'd440) &&
+                (((y >= 9'd154) && (y < 9'd166)) ||
+                 ((y >= 9'd210) && (y < 9'd222)) ||
+                 ((y >= 9'd266) && (y < 9'd278)) ||
+                 ((y >= 9'd322) && (y < 9'd334)))) begin
+                if ((x - 10'd248) < setting_bar_width)
+                    rgb_comb = 24'h34D6FF;
+                else
